# ============================================================
# ROYAL RIDES SERVER — Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- MongoDB ---
# Local:   mongodb://localhost:27017/royal_rides
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/royal_rides
MONGO_URI=mongodb://localhost:27017/royal_rides

# --- JWT ---
# Generate strong secrets: `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_ACCESS_SECRET=your_access_token_secret_here_minimum_64_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_here_minimum_64_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# --- Cloudinary (Image Uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (Nodemailer) ---
# For production: use SendGrid, Mailgun, SES, etc.
# For development: use Mailtrap (https://mailtrap.io)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
EMAIL_FROM=noreply@royalrides.lk
EMAIL_FROM_NAME=Royal Rides

# --- Currency Exchange API (optional — for auto-fetch) ---
EXCHANGE_API_KEY=your_exchange_rate_api_key
EXCHANGE_API_URL=https://v6.exchangerate-api.com/v6

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# --- Admin ---
ADMIN_SEED_EMAIL=admin@royalrides.lk
ADMIN_SEED_PASSWORD=Admin@123456

# --- Logging ---
LOG_LEVEL=debug
