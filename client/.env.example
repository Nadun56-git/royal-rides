# ============================================================
# ROYAL RIDES CLIENT — Environment Configuration Example
# ============================================================

# API base URL (must match your server port)
VITE_API_URL=http://localhost:5000/api/v1

# App name shown in meta tags and preloader
VITE_APP_NAME=Royal Rides

# Default currency (LKR or USD)
VITE_DEFAULT_CURRENCY=LKR

# Google Maps / Mapbox (optional, for enhanced maps)
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# WhatsApp contact number (without +)
VITE_WHATSAPP_NUMBER=94718282758
